[
    {sasl, [
        {sasl_error_logger, {file, "logs/sasl.log"}}
    ]},
    {kernel, [
        {start_pg, true},
        {logger_level, {{log_level}}},
        {logger, [
            {handler, default, logger_std_h,
                #{
                    formatter => {logger_formatter, #{}}
                }
            },
            {handler, disk_debug_log, logger_disk_log_h,
                #{
                    config => #{
                        file => "logs/debug",
                        type => wrap,
                        max_no_files => 10,
                        max_no_bytes => 52428800
                    },
                    level => debug,
                    formatter => {logger_formatter, #{single_line => true}}
                }
            },
            {handler, disk_notice_log, logger_disk_log_h,
                #{
                    config => #{
                        file => "logs/notice",
                        type => wrap,
                        max_no_files => 10,
                        max_no_bytes => 52428800
                    },
                    level => notice,
                    formatter => {logger_formatter, #{single_line => true}}
                }
            },
            {handler, disk_warning_log, logger_disk_log_h,
                #{
                    config => #{
                        file => "logs/warning",
                        type => wrap,
                        max_no_files => 10,
                        max_no_bytes => 52428800
                    },
                    level => warning,
                    formatter => {logger_formatter, #{single_line => true}}
                }
            },
            {handler, disk_error_log, logger_disk_log_h,
                #{
                    config => #{
                        file => "logs/error",
                        type => wrap,
                        max_no_files => 10,
                        max_no_bytes => 52428800
                    },
                    level => error,
                    formatter => {logger_formatter, #{single_line => true}}
                }
            }
        ]}
    ]},

    {hn_aggregator, [
        {hn_api_base_url, "https://hacker-news.firebaseio.com/v0"},
        {hn_api_top_stories_path, "topstories.json"},
        {hn_api_item_path, "item"},
        {polling_rate_ms, {{polling_rate_var_ms}}},
        {top_n, {{top_n_var}}},
        {max_polling_attempts, 3},
        {polling_backoff_ms, 2000},
        {page_size, {{page_size_var}}},

        {max_http_requests, {{max_http_requests_var}}},
        {max_ws_connections, {{max_ws_connections_var}}},

        {rate_limit_cleanup_timeout_ms, {{rate_limit_cleanup_timeout_ms_var}}},

        {ws_idle_timeout_ms, {{ws_idle_timeout_ms_var}}},
        {ws_rate_limit_window_ms, {{ws_rate_limit_window_ms_var}}},
        {ws_rate_limit_msg_max_count, {{ws_rate_limit_msg_max_count_var}}}
    ]}
].
